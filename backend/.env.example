# --- Anthropic (required for the AI Tutor and culture-capsule generation) ---
# Resolved the same way the Anthropic SDKs resolve it: ANTHROPIC_API_KEY, or
# leave unset and run `ant auth login` on this machine. Never expose this to
# the browser — that's the whole point of proxying through this backend.
ANTHROPIC_API_KEY=

# Defaults to claude-opus-4-8. Override to claude-sonnet-5 or claude-haiku-4-5
# if you want to trade quality for lower cost on a low-resource language task.
ANTHROPIC_MODEL=claude-opus-4-8

# --- Azure AI Speech (optional — real ga-IE neural TTS) ---
# Without these, the frontend falls back to the browser's approximate voice
# reading the phonetic respelling. Get a free key at
# https://azure.microsoft.com/en-us/products/ai-services/ai-speech
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# --- Pronunciation ASR service (optional — see services/pronunciation-asr) ---
PRONUNCIATION_ASR_URL=http://localhost:8000

# --- Access control ---
# If set, every /api/* request must send `Authorization: Bearer <token>`.
# Strongly recommended once this backend is reachable from the internet,
# since it spends your Anthropic and Azure credits on every AI Tutor /
# capsule-generation / TTS call.
BLAS_ACCESS_TOKEN=

# --- Server ---
PORT=8787
CORS_ORIGIN=http://localhost:5173
PROGRESS_DATA_FILE=./data/progress.json
